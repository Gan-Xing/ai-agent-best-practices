    "github:repo:fetch": "tsx skills/github-reference-entry/scripts/fetch-repo-context.ts",
    "content:import": "tsx scripts/content-import.ts",
    "content:verify": "tsx scripts/content-contract-check.ts && tsx scripts/content-validate.ts && tsx scripts/content-import.ts --dry-run",
    "skill:github-reference:apply": "tsx skills/github-reference-entry/scripts/apply-draft.ts",
    "skill:github-reference:validate": "tsx skills/github-reference-entry/scripts/quick_validate.ts",
    "skill:knowledge-record:apply": "tsx skills/knowledge-record-entry/scripts/apply-draft.ts",
    "skill:knowledge-record:validate": "tsx skills/knowledge-record-entry/scripts/quick_validate.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "next": "16.2.6",
    "pg": "^8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma"
    ],

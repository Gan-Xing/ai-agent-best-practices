[Unit]
Description=AI Agent Best Practices Next.js App
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/dev/ai-agent-best-practices
Environment=NODE_ENV=production
Environment=PORT=3020
EnvironmentFile=/home/ubuntu/dev/ai-agent-best-practices/.env
ExecStart=/bin/sh /home/ubuntu/dev/ai-agent-best-practices/ops/systemd/start-ai-agent-best-practices.sh
Restart=on-failure
RestartSec=5
SyslogIdentifier=ai-agent-best-practices

[Install]
WantedBy=multi-user.target

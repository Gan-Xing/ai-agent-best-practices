[Unit]
Description=AI Agent Best Practices Next.js App
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/dev/ai-agent-best-practices
Environment=NODE_ENV=production
Environment=PORT=3020
EnvironmentFile=/home/ubuntu/dev/ai-agent-best-practices/.env
ExecStart=/home/ubuntu/.nvm/versions/node/v24.15.0/bin/node /home/ubuntu/dev/ai-agent-best-practices/node_modules/next/dist/bin/next start -p 3020
Restart=on-failure
RestartSec=5
SyslogIdentifier=ai-agent-best-practices

[Install]
WantedBy=multi-user.target

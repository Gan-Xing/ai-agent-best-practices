DATABASE_URL="postgresql://knowledge:knowledge@localhost:5432/knowledge"

# Recommended for incremental GitHub metadata sync.
# Scheduled sync uses conditional requests and small batches, but production
# deployments should still provide a token once the card library grows.
# GITHUB_TOKEN="<github_personal_access_token>"

# Optional scheduled-sync tuning.
# The default scheduler runs small batches four times per day. These knobs let
# you reduce per-run load further or speed catch-up when the library grows.
# GITHUB_SYNC_BATCH_SIZE="12"
# GITHUB_SYNC_MAX_REQUESTS="80"
# GITHUB_SYNC_MIN_REMAINING="400"
# GITHUB_SYNC_REPO_DELAY_MS="1200"
# GITHUB_SYNC_HOT_INTERVAL_HOURS="24"
# GITHUB_SYNC_WARM_INTERVAL_HOURS="72"
# GITHUB_SYNC_COOL_INTERVAL_HOURS="168"
# GITHUB_SYNC_COLD_INTERVAL_HOURS="336"
# GITHUB_SYNC_ARCHIVED_INTERVAL_HOURS="720"

# Optional production bind address.
# Leave unset to listen on all interfaces. Set this on the server to bind to
# one private interface, for example a Tailscale address.
# APP_HOST="127.0.0.1"

# Optional failure-alert webhook for scheduled GitHub upstream sync.
# The alert payload is JSON and includes summaryText plus structured fields.
# GITHUB_SYNC_ALERT_WEBHOOK_URL="https://example.com/hooks/github-sync"
# GITHUB_SYNC_ALERT_WEBHOOK_BEARER_TOKEN="<token>"
